# Chromium is removing client-side XSLT, so feeds styled with style.xsl no
# longer render there. `make build` pre-renders each feed with xsltproc into
# a sibling `index.xml.html`; browsers (whose Accept header starts with
# text/html) get that page, while feed readers keep receiving the raw XML.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_ACCEPT} ^text/html
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+\.xml)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.xml(\.html)?$">
    Header append Vary Accept
  </FilesMatch>
</IfModule>

# GCVE-BCP-03 feeds of GNA 2015 (generated by Hugo, see content/disclosures/).
# Hugo cannot write a file without an extension, so the pull API path is
# served from publication.json; the query string (page, per_page...) is ignored.
AddType application/x-ndjson .ndjson
<IfModule mod_rewrite.c>
  RewriteRule ^api/gcve/publication/?$ api/gcve/publication.json [L,T=application/json]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(publication\.json|gna-[0-9]+\.ndjson|record\.json)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
